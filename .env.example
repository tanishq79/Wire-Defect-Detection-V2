# Comma-separated browser origins allowed to call the API.
WIRE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Reject larger uploads before image decoding. Value is bytes.
WIRE_MAX_UPLOAD_BYTES=26214400

# Raspberry Pi hardware features. Keep disabled on regular desktops.
WIRE_BUTTON_ENABLED=1
WIRE_MOTOR_ENABLED=1
WIRE_MACHINE_BUTTONS_ENABLED=0

# Machine counter range and current state storage.
WIRE_MACHINE_MIN=100
WIRE_MACHINE_MAX=999
